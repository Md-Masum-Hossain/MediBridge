# ==============================================================================
# MediBridge Monorepo Root .gitignore
# Ignoring node_modules, .next, environment files, and build logs across client/ and server/
# ==============================================================================

# Node dependencies
node_modules/
*/node_modules/
**/node_modules/

# Next.js build output
.next/
*/.next/
**/next-env.d.ts
out/
*/out/

# Environment and sensitive credential files
.env
.env.*
.env*.local
*.env
*.env.*
client/.env*
server/.env*
!**/.env.example
!.env.example

# Build and runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*/logs/

# Build artifacts & distribution
dist/
build/
*/dist/
*/build/

# Uploads and temporary directories
uploads/
*/uploads/
.cache/
*/.cache/
tmp/
temp/

# Operating System & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
