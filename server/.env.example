PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/medibridge
MONGODB_URI=mongodb://localhost:27017/medibridge
JWT_SECRET=medibridge_super_secret_jwt_key_2026

# Google Gemini Vision API Key for OCR & prescription digitization
GEMINI_API_KEY=your_gemini_api_key_here

# Web Push VAPID Keys for background notifications when browser is closed
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@medibridge.app
